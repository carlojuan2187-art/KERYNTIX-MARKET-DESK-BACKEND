# Dedicated Railway service for FTrade background workers.
# Keep this separate from Dockerfile, which runs the public FastAPI process.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    MALLOC_ARENA_MAX=2

WORKDIR /app
COPY requirements-prod.txt ./requirements-prod.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install -r requirements-prod.txt && \
    useradd --create-home --uid 10001 ftrade

COPY api ./api
COPY domain ./domain
COPY engine ./engine
COPY worker ./worker
RUN chown -R ftrade:ftrade /app
USER ftrade

CMD ["python", "-m", "worker.supervisor"]
