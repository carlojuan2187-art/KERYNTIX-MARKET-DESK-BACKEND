# Development default uses an empty in-memory repository. It does NOT persist data.
FTRADE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Use a dedicated database for KERYNTIX MARKET DESK Web; do not point this at the current bot's database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/REPLACE_ME
DATABASE_NAME=ftrade_web
SIGNALS_COLLECTION=signals
USERS_COLLECTION=users
AUTH_REQUESTS_COLLECTION=auth_requests
SESSIONS_COLLECTION=sessions
MONGODB_TIMEOUT_MS=10000

# Required for signed short-lived HS256 Bearer access tokens.
# Use a long random secret from a secret manager in production; never commit it.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MAX_TTL_SECONDS=900
AUTH_CODE_PEPPER=replace-with-a-different-long-random-secret
AUTH_COOKIE_SECURE=false
# Local/same-site example: lax. For genuinely cross-site frontend/API hosts use none (Secure is forced in production).
AUTH_COOKIE_SAMESITE=lax
# Keep true for cross-site-cookie fallback. Set false only after HttpOnly cookie-only mode is verified.
AUTH_REFRESH_IN_BODY=true
# Product rule: every new account receives exactly five full days of Premium-equivalent access.
TRIAL_DAYS=5
# Admins can be identified by internal KERYNTIX MARKET DESK user IDs or verified phone numbers.
# Prefer ADMIN_PHONE_NUMBERS to avoid looking up user IDs in MongoDB. Multiple values: comma-separated.
ADMIN_USER_IDS=
ADMIN_PHONE_NUMBERS=
TELEGRAM_AUTH_BOT_USERNAME=your_keryntix_market_desk_auth_bot
TELEGRAM_AUTH_BOT_TOKEN=replace-with-a-dedicated-bot-token
PHONE_CHALLENGE_IP_LIMIT=10

# Mirrors bot display behavior for recently cancelled signals.
CANCELLED_DISPLAY_MINUTES=30
LOG_LEVEL=INFO

# Shared market cache; required to run API and worker as separate processes
REDIS_URL=redis://localhost:6379/0
BINANCE_FUTURES_WS=wss://fstream.binance.com/market
MARKET_STREAM_WATCHDOG_SECONDS=15
# Reconnect if auxiliary WS messages continue but real mini-ticker prices have stalled.
MARKET_PRICE_WATCHDOG_SECONDS=12

# Live signal scanner (run separately with: python -m worker.signal_scanner)
# Requires persistent MongoDB in a multi-process deployment. Memory mode is only
# for isolated local tests and does not share signals with a separate API process.
SIGNAL_ENGINE_ALLOW_MEMORY=false
MIN_QUOTE_VOLUME=50000000
SCAN_INTERVAL_SECONDS=60
SCAN_CONCURRENCY=4
DEDUP_MINUTES=10
ENTRY_WINDOW_MINUTES=15
SWEEP_OBSERVATIONS_COLLECTION=observed_sweeps
SWEEP_OBSERVATION_RETENTION_MINUTES=20
BINANCE_REQUEST_DELAY=0.2
BINANCE_REST_MAX_CONNECTIONS=8
BINANCE_REST_CONCURRENCY=4

# Shared MongoDB connection-pool caps (applied by API and worker repositories)
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=4
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_MAX_IDLE_TIME_MS=60000

# Shared Redis connection pool
REDIS_MAX_CONNECTIONS=32

# Signal lifecycle / closed-trade outcome monitor (run with: python -m worker.signal_lifecycle)
SIGNAL_RESULTS_COLLECTION=signal_results
LIFECYCLE_ALLOW_MEMORY=false
SIGNAL_MONITOR_INTERVAL_SECONDS=2
SIGNAL_MONITOR_ERROR_BACKOFF_SECONDS=20
SIGNAL_HISTORY_RECHECK_SECONDS=15
OUTCOME_CHECK_SECONDS=20
OUTCOME_LIVE_PRICE_MAX_AGE_SECONDS=5
OUTCOME_MAX_PAGES=10
MARKET_PRICE_MAX_AGE_SECONDS=15
LIFECYCLE_REST_PRICE_REFRESH_SECONDS=10
LIFECYCLE_MAX_PENDING_SIGNALS=2000
LIFECYCLE_MAX_OPEN_TRADES=2000
TOUCHED_DISPLAY_MINUTES=30
TOUCH_ALERT_MAX_AGE_SECONDS=75
TOUCH_MAX_DISTANCE_ATR=0.25
LSR_MIN_PREENTRY_DISTANCE_ATR=0.10
LSR_MAX_PREENTRY_DISTANCE_ATR=0.85
# Calibración de entrada: retroceso moderado, sin añadir filtros de señal.
LSR_PULLBACK_RETRACE_FRACTION=0.42
LSR_PULLBACK_ATR_MIN=0.24

# Reference PLUS strategy filter calibration. These values match the supplied
# strategy_liquidity_sweep.py defaults; set the same values in Railway only if
# corresponding LSR_PLUS_* / PLUS_RAW_SCORE_MIN overrides already exist.
PLUS_RAW_SCORE_MIN=76
LSR_PLUS_ATR_PCT_MIN=0.0015
LSR_PLUS_ATR_PCT_MAX=0.0240
LSR_PLUS_LIQUIDITY_TOLERANCE_ATR=0.50
LSR_PLUS_MIN_SWEEP_ATR=0.10
LSR_PLUS_MIN_REL_VOLUME=0.76
LSR_PLUS_MIN_CONFIRM_REL_VOLUME=0.82
LSR_PLUS_MIN_BODY_RATIO_RECOVERY=0.17
LSR_PLUS_MIN_BODY_RATIO_CONFIRMATION=0.15
LSR_PLUS_MIN_CLOSE_POSITION=0.53
LSR_PLUS_MIN_RR=0.90
LSR_PLUS_HTF_PRICE_TOLERANCE=0.0110
LSR_PLUS_HTF_TREND_TOLERANCE=0.0200
LSR_PLUS_HTF_REQUIRED_SCORE=1

# Plan entitlement reminders (run separately: python -m worker.plan_scheduler)
PLAN_NOTIFICATIONS_COLLECTION=plan_notifications
PLAN_NOTICE_WINDOW_HOURS=24
PLAN_NOTICE_LEASE_SECONDS=90
PLAN_MAINTENANCE_INTERVAL_SECONDS=60
PLAN_MAINTENANCE_ERROR_BACKOFF_SECONDS=30
PLAN_MAINTENANCE_ALLOW_MEMORY=false

# Fase 14: watchlist, price alerts, inbox notifications and market-alert dispatcher
USER_NOTIFICATIONS_COLLECTION=user_notifications
PRICE_ALERTS_COLLECTION=price_alerts
USER_ALERTS_INTERVAL_SECONDS=10
ALERT_DISPATCH_PAGE_SIZE=500
ALERT_DISPATCH_CONCURRENCY=12
LIFECYCLE_REST_CONCURRENCY=4
ALERTS_COOLDOWN_MINUTES=45
ALERTS_MARKET_COOLDOWN_MINUTES=20
ALERTS_MAX_PER_HOUR=8
ALERT_MOVE_PCT_5M=3.5
ALERT_MOVE_PCT_15M=6.0
ALERT_MAJOR_MOVE_PCT_5M=1.0
ALERT_MAJOR_MOVE_PCT_15M=1.8
ALERT_LIQ_MARKET_USD=12000000
ALERT_LIQ_MARKET_SHARE=0.70
ALERT_LIQ_SYMBOL_USD=3000000
ALERT_LIQ_SYMBOL_SHARE=0.75
ALERT_MOVE_VOLUME=3.0
ALERT_VOLUME_RATIO=6.0

# Premium billing (read-only USDT BEP20 verification; never configure a private key)
PREMIUM_PRICE_USDT=10.00
PAYMENT_WALLET_ADDRESS=
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_CHAIN_DECIMALS=18
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_MIN_CONFIRMATIONS=12
BSC_LOG_CHUNK_BLOCKS=4000
BSC_MAX_CHUNKS=40
PAYMENT_WINDOW_MINUTES=180
PAYMENT_MAX_ATTEMPTS=20
PAYMENT_RETRY_COOLDOWN_SECONDS=8
PAYMENT_VERIFY_LEASE_SECONDS=90
PAYMENTS_COLLECTION=payments
PAYMENT_TXS_COLLECTION=payment_txs
REFERRALS_COLLECTION=referrals
REFERRAL_REWARDS_COLLECTION=referral_rewards
SUPPORT_TICKETS_COLLECTION=support_tickets
ADMIN_AUDIT_COLLECTION=admin_audit

# Fase 16/18: distributed worker coordination, reconciliation, and readiness
# In production, set an explicit stable namespace unique to the deployment.
FTRADE_DEPLOYMENT_NAME=development
WORKER_LEASE_TTL_SECONDS=90
WORKER_LEASE_RETRY_SECONDS=5
BUSINESS_RECONCILIATION_INTERVAL_SECONDS=30
BUSINESS_RECONCILIATION_ERROR_BACKOFF_SECONDS=20
BUSINESS_RECONCILIATION_BATCH_SIZE=200
BUSINESS_RECONCILIATION_ALLOW_MEMORY=false

# Fase 17: durable Telegram notification outbox
TELEGRAM_DELIVERY_INTERVAL_SECONDS=3
TELEGRAM_DELIVERY_BATCH_SIZE=20
TELEGRAM_DELIVERY_MAX_ATTEMPTS=8
TELEGRAM_DELIVERY_LEASE_SECONDS=90
TELEGRAM_DELIVERY_RETRY_BASE_SECONDS=5
TELEGRAM_DELIVERY_RETRY_MAX_SECONDS=3600

# Fase 18: production readiness. Set CORS_ORIGINS to the HTTPS frontend origin(s).

# Browser Web Push (generate an EC P-256 VAPID key pair; never publish the private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=
# Alternative for managed hosting: PEM content in a secret variable; worker writes it to a mode-0600 temp file
VAPID_PRIVATE_KEY_PEM=
# Alternative to multiline PEM when your hosting dashboard prefers a single-line secret
VAPID_PRIVATE_KEY_PEM_B64=
VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_MAX_ATTEMPTS=8
WEB_PUSH_RETRY_BASE_SECONDS=5
WEB_PUSH_RETRY_MAX_SECONDS=3600

# Public frontend URL used to build referral links (must point to the web app, not Telegram).
FRONTEND_URL=https://keryntix-market-desk-production.up.railway.app
